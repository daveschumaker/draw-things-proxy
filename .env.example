# Server Configuration
NODE_ENV=development
PORT=3001
HOST=localhost

# DrawThings API Configuration
DRAW_THINGS_API_URL=http://127.0.0.1:7860/sdapi/v1/txt2img
DRAW_THINGS_STATUS_URL=http://127.0.0.1:7860/

# Directory Configuration
# Required: Directory where generated images will be saved
SAVE_IMAGE_DIR=/path/to/save/images

# Required: Directory where DrawThings outputs images
DRAW_THINGS_IMAGE_DIR=/path/to/drawthings/output

# Job Queue Configuration
MAX_JOB_RETRIES=3
COMPLETED_JOB_TTL_MS=3600000
QUEUE_PROCESS_DELAY_MS=1000
QUEUE_POLL_INTERVAL_MS=2000

# Health Check Configuration
HEALTH_CHECK_INTERVAL_MS=60000

# Request Configuration
REQUEST_BODY_SIZE_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000

# Rate Limiting Configuration
# Time window in milliseconds for rate limiting (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Maximum requests per window for general endpoints (default: 100)
RATE_LIMIT_MAX_REQUESTS=100
# Maximum requests per window for /api/generate endpoint (default: 10)
RATE_LIMIT_GENERATE_MAX=10

# CORS Configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=false
